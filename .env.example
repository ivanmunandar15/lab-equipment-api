NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://lab:lab_password@localhost:5432/lab_equipment?schema=public
JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-32-karakter-aaaa
JWT_REFRESH_SECRET=ganti-dengan-string-acak-lain-minimal-32-karakter-bbbb
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# lax | strict | none (none hanya jika frontend beda site; otomatis secure)
COOKIE_SAME_SITE=lax
# Pisahkan dengan koma untuk beberapa origin
CORS_ORIGIN=http://localhost:3001
# Base URL untuk isi QR code (frontend/scan page)
APP_URL=http://localhost:3001
UPLOAD_DIR=./uploads
# block = tolak jika melebihi kapasitas ruangan | warn = izinkan + kembalikan peringatan
ROOM_CAPACITY_MODE=block
# calibration_state=due_soon jika jatuh tempo dalam N hari
CALIBRATION_DUE_SOON_DAYS=30
LOG_LEVEL=info

# Kalibrasi terlambat saat meminjam: warn (peringatan saja) | block (tolak)
CALIBRATION_OVERDUE_POLICY=block

# Batas ukuran sertifikat kalibrasi (MB)
CERTIFICATE_MAX_MB=5

# Monitoring sensor
MONITORING_RETENTION_DAYS=90
MONITORING_ALERT_COOLDOWN_MINUTES=30
# Dokumen alat
DOCUMENT_MAX_MB=10
# false = job cron (retensi) tidak jalan di instance ini
JOBS_ENABLED=true

# Dashboard & job terjadwal (Tahap 10)
LOW_STOCK_THRESHOLD=2
DASHBOARD_CACHE_SECONDS=30
JOBS_TIMEZONE=Asia/Jakarta

# Email pengingat (Tahap 11)
# false = email TIDAK dikirim, hanya dicatat ke log + EMAIL_LOG (aman untuk dev)
EMAIL_ENABLED=false
# Dev: docker compose --profile tools up -d mailhog  (UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lab Equipment <no-reply@lab.local>"
FRONTEND_URL=http://localhost:3001
OVERDUE_REMINDER_REPEAT_DAYS=3
